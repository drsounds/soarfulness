{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Archetypes",
  "type": "object",
  "required": ["archetypes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "archetypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "description", "parent"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "parent": { "type": ["string", "null"] }
        }
      }
    }
  }
}
