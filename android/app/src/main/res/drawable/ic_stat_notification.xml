<?xml version="1.0" encoding="utf-8"?>
<!-- Notification small icon: the launcher glyph tinted with the adaptive
     foreground colour (dark by day, white at night). The status bar still
     renders small icons as a silhouette; the notification sets the same
     colour with setColor() so the shade header shows it too. -->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@drawable/ic_stat_notification_glyph"
    android:tint="@color/ic_launcher_foreground_tint" />
