# Using Android gitignore template: https://github.com/github/gitignore/blob/HEAD/Android.gitignore

# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
#  Uncomment the following line in case you need and you don't have the release build type files in your app
# release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
# Android Studio 3 in .gitignore file.
.idea/caches
.idea/modules.xml
# Comment next line if keeping position of elements in Navigation Editor is relevant for you
.idea/navEditor.xml

# Keystore files — the real upload keystore is never committed (see
# CAPACITOR_APP.md's "Play Store signing" section); CI decodes it from the
# ANDROID_UPLOAD_KEYSTORE_BASE64 secret into a gitignored file at build time.
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Cordova plugins for Capacitor — committed, not ignored (despite this
# repo's stock .gitignore template default). Unlike app/src/main/assets
# below, this is real Gradle project scaffolding (build.gradle,
# cordova.variables.gradle, AndroidManifest.xml — ~36K, no web assets)
# that `cap sync` generates once and the build then depends on directly;
# CI no longer runs `cap sync` (see below), so if this weren't committed
# the build would fail with "Could not read script
# '.../capacitor-cordova-android-plugins/cordova.variables.gradle' as it
# does not exist" — confirmed by hitting exactly that failure.
# capacitor-cordova-android-plugins

# Copied web assets and generated config files. Built here (locally, not
# in CI — see CAPACITOR_APP.md) via `npm run build:capacitor && npx cap
# sync android`, but NOT committed to git — a ~50MB+ binary bundle in every
# commit that touches it would bloat this repo's history forever. Instead
# it's published as the "capacitor-web-bundle" GitHub Release asset (via
# .github/workflows/publish-capacitor-web-bundle.yml), and
# capacitor-android-build.yml's Gradle jobs download+extract it here at
# build time.
app/src/main/assets/public
app/src/main/assets/capacitor.config.json
app/src/main/assets/capacitor.plugins.json

app/src/main/res/xml/config.xml
